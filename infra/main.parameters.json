{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "environmentType": {
      "value": "${ENVIRONMENT_TYPE=dev}"
    },
    "postgresAdminPassword": {
      "value": "${POSTGRES_ADMIN_PASSWORD}"
    },
    "devDatabaseConnectionString": {
      "value": "${DEV_DATABASE_CONNECTION_STRING=}"
    },
    "jwtSecretKey": {
      "value": "${JWT_SECRET_KEY}"
    },
    "corsAllowedOrigin": {
      "value": "${CORS_ALLOWED_ORIGIN=}"
    },
    "deployAiAgents": {
      "value": "${DEPLOY_AI_AGENTS=false}"
    },
    "openaiLocation": {
      "value": "${OPENAI_LOCATION=eastus2}"
    },
    "openaiDeploymentName": {
      "value": "${OPENAI_DEPLOYMENT_NAME=gpt-4o}"
    },
    "openaiModelVersion": {
      "value": "${OPENAI_MODEL_VERSION=2024-08-06}"
    },
    "openaiSkuName": {
      "value": "${OPENAI_SKU_NAME=GlobalStandard}"
    }
  }
}
