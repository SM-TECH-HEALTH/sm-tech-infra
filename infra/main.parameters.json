{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "environmentType": {
      "value": "${ENVIRONMENT_TYPE=dev}"
    },
    "postgresAdminPassword": {
      "value": "${POSTGRES_ADMIN_PASSWORD}"
    },
    "devDatabaseConnectionString": {
      "value": "${DEV_DATABASE_CONNECTION_STRING=}"
    },
    "jwtSecretKey": {
      "value": "${JWT_SECRET_KEY}"
    },
    "corsAllowedOrigin": {
      "value": "${CORS_ALLOWED_ORIGIN=}"
    },
    "deployAiAgents": {
      "value": "${DEPLOY_AI_AGENTS=false}"
    },
    "openaiLocation": {
      "value": "${OPENAI_LOCATION=eastus2}"
    },
    "openaiModelName": {
      "value": "${OPENAI_MODEL_NAME=}"
    },
    "openaiDeploymentName": {
      "value": "${OPENAI_DEPLOYMENT_NAME=}"
    },
    "openaiModelVersion": {
      "value": "${OPENAI_MODEL_VERSION=}"
    },
    "openaiSkuName": {
      "value": "${OPENAI_SKU_NAME=GlobalStandard}"
    },
    "initialContainerImage": {
      "value": "${API_CONTAINER_IMAGE=mcr.microsoft.com/azuredocs/containerapps-helloworld:latest}"
    },
    "agentsInitialContainerImage": {
      "value": "${AGENTS_CONTAINER_IMAGE=mcr.microsoft.com/azuredocs/containerapps-helloworld:latest}"
    },
    "agentsCustomDomainName": {
      "value": "${AGENTS_CUSTOM_DOMAIN_NAME=}"
    },
    "agentsCustomDomainCertificateId": {
      "value": "${AGENTS_CUSTOM_DOMAIN_CERTIFICATE_ID=}"
    },
    "apiCustomDomainName": {
      "value": "${API_CUSTOM_DOMAIN_NAME=}"
    },
    "apiCustomDomainCertificateId": {
      "value": "${API_CUSTOM_DOMAIN_CERTIFICATE_ID=}"
    }
  }
}
